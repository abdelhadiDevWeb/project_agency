# Copy to .env and fill in real values:
#   copy .env.example .env
#
# Never commit .env. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

NODE_ENV=development
PORT=4000

# MongoDB (required)
MONGODB_URI=mongodb://127.0.0.1:27017/agency_vo

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# JWT (required, min 32 chars) — replace in every environment
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=agency_vo
JWT_AUDIENCE=agency_vo

# Signed cookies / CSRF (required, min 32 chars)
COOKIE_SECRET=replace-with-another-long-random-secret-at-least-32

# CSRF: enable only when using cookie-based browser auth
CSRF_ENABLED=false

# Behind nginx / Cloudflare / Render: set to 1
TRUST_PROXY=false

# Require JWT on Socket.IO handshake (recommended true in production)
SOCKET_REQUIRE_AUTH=false

# Demo POST /api/auth/token — MUST be false in production
ALLOW_DEMO_AUTH=true

# First super admin — created on startup only if this email is not in the admin table yet.
# The password is hashed before saving; you can remove it from .env after the first start.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-password
DEFAULT_ADMIN_NAME=Super Admin

# Redis (optional; enables shared rate limits + Socket.IO scale-out)
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
